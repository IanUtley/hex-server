{
 "schema_version": 1,
 "campaign": "The Tranquil Dream",
 "description": "Score the authored one, two, and three point answers.",
 "start": {
  "node": "NodeA",
  "node_completed": false,
  "counters": {
   "answer_score": 0
  }
 },
 "map": {
  "paths": [
   {"id": "Path_NodeA_NodeG", "from": "NodeA", "to": "NodeG"},
   {"id": "Path_NodeB_NodeG", "from": "NodeB", "to": "NodeG"},
   {"id": "Path_NodeC_NodeG", "from": "NodeC", "to": "NodeG"},
   {"id": "Path_NodeD_NodeG", "from": "NodeD", "to": "NodeG"},
   {"id": "Path_NodeE_NodeG", "from": "NodeE", "to": "NodeG"},
   {"id": "Path_NodeF_NodeG", "from": "NodeF", "to": "NodeG"}
  ]
 },
 "hooks": [
  {
   "id": "answer_score:one_point_answer",
   "on": {"event": "script_event", "name": "one_point_answer"},
   "do": [{"increment_counter": {"name": "answer_score", "amount": 1}}]
  },
  {
   "id": "answer_score:two_point_answer",
   "on": {"event": "script_event", "name": "two_point_answer"},
   "do": [{"increment_counter": {"name": "answer_score", "amount": 2}}]
  },
  {
   "id": "answer_score:three_point_answer",
   "on": {"event": "script_event", "name": "three_point_answer"},
   "do": [{"increment_counter": {"name": "answer_score", "amount": 3}}]
  }
 ]
}
